# URL pública del API Gateway (para llamadas HTTP y WebSocket /orders)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Feature flags para el dashboard de administración
# Formato: flag1:boolean,flag2:boolean
# Flags soportadas: kitchen-display, payments, analytics, multi-language
NEXT_PUBLIC_FEATURE_FLAGS=kitchen-display:true,payments:true

