generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("ORDERING_DATABASE_URL")
}

enum OrderStatus {
  PLACED
  IN_KITCHEN
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  tenantId    String
  sessionId   String
  tableId     String
  status           OrderStatus        @default(PLACED)
  kitchenStatus    OrderStatus?
  barStatus        OrderStatus?
  total            Decimal            @db.Decimal(10, 2)
  notes            String?
  estimatedMinutes Int?
  delayMinutes     Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  cancelledAt      DateTime?
  items            OrderItem[]
  statusEvents     OrderStatusEvent[]

  @@index([tenantId, sessionId])
  @@index([tenantId, status])
}

model OrderStatusEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String
  toStatus   String
  occurredAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          String              @id @default(uuid())
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  unitPrice   Decimal             @db.Decimal(10, 2)
  quantity    Int
  notes       String?
  destination String              @default("kitchen")
  modifiers   OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupId     String
  groupName   String
  optionId    String
  optionName  String
  priceDelta  Decimal   @default(0) @db.Decimal(10, 2)

  @@index([orderItemId])
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  sessionId   String
  tableId     String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  ordersCount Int
  recordedBy    String
  createdAt     DateTime      @default(now())
  invoiceStatus String        @default("none")
  invoiceRef    String?
  invoiceError  String?

  @@unique([tenantId, sessionId])
  @@index([tenantId, createdAt])
}
