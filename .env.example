# RESTAURANTE-OS - Entorno de desarrollo
GATEWAY_PORT=4000
JWT_SECRET=super-secret-jwt-key-oleada-0
INTERNAL_SHARED_SECRET=resto-internal-shared-secret-dev-2026
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# URL publica de la PWA (base de los enlaces/QR de las mesas)
PWA_BASE_URL=http://localhost:3001

# URLs Upstream
IDENTITY_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
SESSION_SERVICE_URL=http://localhost:4003
ORDERING_SERVICE_URL=http://localhost:4004

# Bases de datos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

# Configuración de red y demo local (usadas por pnpm demo)
# LAN_IP: IP del host para acceso desde celular en misma red WiFi (autodetectada si se omite)
LAN_IP=
# MIN_ADMIN_PASSWORD_LENGTH: Longitud mínima de contraseña admin (default 8 en prod, 4 para demo)
MIN_ADMIN_PASSWORD_LENGTH=8
# DEMO_ADMIN_PASSWORD: Contraseña de la cuenta admin demo en seed-demo (default: admin)
DEMO_ADMIN_PASSWORD=admin

# URLs públicas y feature flags de frontends
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_FEATURE_FLAGS=online-ordering:true,table-qr:true

